<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

    <!-- Camera Permission -->
    <key>NSCameraUsageDescription</key>
    <string>HairJourney uses your camera to capture milestone scalp and hairline photos for tracking progress over time.</string>

    <!-- Photo Library Permission -->
    <key>NSPhotoLibraryUsageDescription</key>
    <string>HairJourney accesses your photos so you can select and upload hair growth pictures for visual comparison.</string>

    <!-- Save to Gallery Permission -->
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>HairJourney requires permission to save your before-and-after hair progress comparison images to your photo library.</string>

    <!-- Allow HTTP Connections -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSExceptionDomains</key>
        <dict>

            <key>14.139.187.229</key>
            <dict>
                <key>NSExceptionAllowsInsecureHTTPLoads</key>
                <true/>
            </dict>

            <key>localhost</key>
            <dict>
                <key>NSExceptionAllowsInsecureHTTPLoads</key>
                <true/>
            </dict>

        </dict>
    </dict>

</dict>
</plist>
